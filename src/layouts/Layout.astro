---
import "../styles/global.css";
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Jaipur Balloon Decoration",
	description = "India's No.1 decor service in Jaipur with trusted decorators for every celebration." 
} = Astro.props;

// Absolute canonical path and OpenGraph metadata
const siteDomain = "https://balloondecorjaipur.com";
const cleanPath = Astro.url.pathname.replace(/\/$/, "");
const canonicalUrl = `${siteDomain}${cleanPath}/`;
const ogImageUrl = `${siteDomain}/Hero-png.png`;

// Local Business Schema JSON-LD
const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	"name": "Jaipur Balloon Decoration",
	"alternateName": ["Jaipur Balloon Decor", "Balloon Decoration Jaipur", "Best Balloon Decoration in Jaipur"],
	"image": ogImageUrl,
	"logo": "https://camsstorage2026abcd.blob.core.windows.net/balooon/Gfg-logo.webp",
	"url": siteDomain,
	"telephone": "+918690924378",
	"priceRange": "$$",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "Plot No. 14, Sahil Sagar Appartment, (Maharani Farm, Gayatri Nagar B, Durgapura)",
		"addressLocality": "Jaipur",
		"addressRegion": "Rajasthan",
		"postalCode": "302018",
		"addressCountry": "IN"
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "26.8501",
		"longitude": "75.7783"
	},
	"openingHoursSpecification": {
		"@type": "OpeningHoursSpecification",
		"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
		"opens": "08:00",
		"closes": "22:00"
	},
	"sameAs": [
		"https://www.instagram.com/balloon_decor_jaipur75/"
	],
	"areaServed": [
		{
			"@type": "AdministrativeArea",
			"name": "Jaipur"
		},
		{
			"@type": "AdministrativeArea",
			"name": "Mansarovar, Jaipur"
		},
		{
			"@type": "AdministrativeArea",
			"name": "Vaishali Nagar, Jaipur"
		},
		{
			"@type": "AdministrativeArea",
			"name": "Malviya Nagar, Jaipur"
		},
		{
			"@type": "AdministrativeArea",
			"name": "Jagatpura, Jaipur"
		},
		{
			"@type": "AdministrativeArea",
			"name": "C-Scheme, Jaipur"
		}
	],
	"description": "Premium balloon decoration services in Jaipur for birthday, anniversary, kids theme parties, welcome baby events, proposal, and room decoration."
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Crawler & Bot Controls -->
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="googlebot" content="index, follow" />
		<meta name="bingbot" content="index, follow" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		
		<!-- OpenGraph / Facebook Meta Tags -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Jaipur Balloon Decoration" />
		
		<!-- Twitter Cards Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<title>{title}</title>

		<!-- Structured Data JSON-LD for Local Business -->
		<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
	</head>
	<body>
		<slot />
		<Analytics />
		<SpeedInsights />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>

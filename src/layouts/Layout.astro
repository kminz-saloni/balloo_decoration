---
import "../styles/global.css";

interface Props {
	title?: string;
}

const { title = "Jaipur Balloon Decoration" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="https://camsstorage2026abcd.blob.core.windows.net/balooon/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="India's No.1 decor service in Jaipur with trusted decorators for every celebration."
		/>
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>

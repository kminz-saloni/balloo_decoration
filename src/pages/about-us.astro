---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us | Jaipur Balloon Decoration" description="Learn about Balloon Decor Jaipur — Jaipur's most-booked balloon decoration team. Our story, team, and commitment to making your celebrations unforgettable.">
	<main class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
		<h1 class="text-3xl font-extrabold text-[#1f2a44]">About Us</h1>
		<p class="mt-2 text-sm text-[#6b7a99]">Balloon Decor Jaipur</p>

		<div class="mt-8 space-y-8 text-base leading-relaxed text-[#4f5e7c]">
			<section>
				<h2 class="text-xl font-bold text-[#1f2a44]">Who We Are</h2>
				<p class="mt-2">Balloon Decor Jaipur is Jaipur's most trusted balloon and event decoration service. We specialise in transforming your celebrations — whether it is a birthday, anniversary, baby shower, wedding, or corporate event — into beautifully styled, photo-ready experiences.</p>
				<p class="mt-3">Our team of experienced decorators brings creativity, professionalism, and attention to detail to every setup, ensuring your event looks exactly the way you imagined it.</p>
			</section>

			<section>
				<h2 class="text-xl font-bold text-[#1f2a44]">Our Mission</h2>
				<p class="mt-2">To make every celebration in Jaipur unforgettable — through stunning balloon arrangements, thematic setups, and same-day decoration services.</p>
			</section>

			<section>
				<h2 class="text-xl font-bold text-[#1f2a44]">What Makes Us Different</h2>
				<ul class="mt-3 list-disc pl-6 space-y-2">
					<li><strong>Same-day booking available</strong> for selected slots and setups.</li>
					<li><strong>We bring everything</strong> — balloons, props, materials, and setup crew.</li>
					<li><strong>Customized setups</strong> tailored to your theme, colour, and venue.</li>
					<li><strong>500+ satisfied customers</strong> across Jaipur and nearby areas.</li>
					<li><strong>Professional team</strong> with an eye for detail and a passion for celebrations.</li>
				</ul>
			</section>

			<section>
				<h2 class="text-xl font-bold text-[#1f2a44]">Our Services</h2>
				<p class="mt-2">We offer a full range of decoration services including:</p>
				<ul class="mt-3 list-disc pl-6 space-y-2">
					<li>Birthday Balloon Decoration</li>
					<li>Anniversary Room Decoration</li>
					<li>Baby Shower &amp; Welcome Baby Decoration</li>
					<li>Wedding &amp; Bridal Decoration</li>
					<li>Kids Theme Decoration (Cocomelon, Baby Shark, Jungle, Frozen, and more)</li>
					<li>Romantic Room &amp; Canopy Decoration</li>
					<li>Corporate Event Decoration</li>
					<li>Festival Decoration</li>
				</ul>
			</section>

			<section>
				<h2 class="text-xl font-bold text-[#1f2a44]">Areas We Serve</h2>
				<p class="mt-2">We serve all major areas of Jaipur including Vaishali Nagar, Mansarovar, Malviya Nagar, Jagatpura, C-Scheme, Tonk Road, and more.</p>
			</section>

			<section>
				<h2 class="text-xl font-bold text-[#1f2a44]">Get in Touch</h2>
				<p class="mt-2">Ready to book your next decoration? Contact us on WhatsApp at <a href="https://wa.me/918690924378" class="text-[#6b3fe7] underline" target="_blank" rel="noreferrer">+91 86909 24378</a> or call us directly. We would love to make your celebration unforgettable!</p>
			</section>
		</div>

		<div class="mt-10">
			<a href="/" class="inline-flex items-center gap-2 rounded-full bg-[#6b3fe7] px-5 py-2.5 text-sm font-semibold text-white">
				← Back to Home
			</a>
		</div>
	</main>
</Layout>


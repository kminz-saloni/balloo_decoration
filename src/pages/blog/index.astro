---
import Layout from '../../layouts/Layout.astro';
import { blogPosts } from '../../data/blog-data';
---

<Layout title="Jaipur Balloon Decoration Blog | Expert Event Decor Tips" description="Read our expert balloon decoration tips and planning guides for birthdays, anniversaries, romantic rooms, and kids cartoon themes in Jaipur.">
	<main class="min-h-screen bg-[linear-gradient(180deg,#edf3ff_0%,#f5f8ff_36%,#f4f7fd_100%)] pb-28 lg:pb-10">
		<div class="mx-auto w-full max-w-[1320px] px-4 pt-6 sm:px-6 lg:px-8">
			
			<div class="text-center max-w-[800px] mx-auto mb-10">
				<h1 class="text-3xl font-extrabold text-[#1f2a44] sm:text-4xl lg:text-5xl">
					Jaipur Balloon Decor Blog
				</h1>
				<p class="mt-3 text-base text-[#5f6b86] sm:text-lg">
					Expert tips, trending theme ideas, and event planning guides to make your celebrations in Jaipur absolutely magical.
				</p>
			</div>

			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
				{
					blogPosts.map((post) => (
						<article class="overflow-hidden rounded-2xl border border-[#d9e3f2] bg-white shadow-[0_14px_24px_-22px_rgba(54,67,122,0.36)] transition hover:shadow-md flex flex-col">
							<img src={post.image} alt={post.title} class="h-44 w-full object-cover" loading="lazy" />
							<div class="p-4 flex-1 flex flex-col justify-between">
								<div>
									<div class="flex items-center gap-2">
										<span class="text-xs font-semibold text-[#5b4fda] bg-[#efe8ff] px-2 py-0.5 rounded-full">{post.categoryTitle}</span>
										<span class="text-xs text-[#8c96ac]">{post.publishDate}</span>
									</div>
									<h2 class="mt-2 text-base font-semibold leading-tight text-[#1f2a44] line-clamp-2">
										<a href={`/blog/${post.slug}`} class="hover:text-[#5b4fda]">
											{post.title}
										</a>
									</h2>
									<p class="mt-2 text-xs text-[#5f6b86] line-clamp-3">{post.description}</p>
								</div>
								<a
									href={`/blog/${post.slug}`}
									class="mt-4 inline-flex items-center justify-center gap-1 rounded-lg border border-[#d9e3f2] bg-white px-3 py-2 text-xs font-bold text-[#5b4fda] hover:bg-[#edf2ff] transition"
								>
									READ ARTICLE
									<svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M5 12h14M12 5l7 7-7 7"></path>
									</svg>
								</a>
							</div>
						</article>
					))
				}
			</div>

		</div>
	</main>
</Layout>

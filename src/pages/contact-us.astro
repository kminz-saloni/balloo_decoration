---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us | Jaipur Balloon Decoration" description="Contact Balloon Decor Jaipur for bookings, inquiries, and event planning. Call or WhatsApp us at +91 86909 24378.">
	<main class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
		<h1 class="text-3xl font-extrabold text-[#1f2a44]">Contact Us</h1>
		<p class="mt-2 text-base text-[#6b7a99]">We're here to make your celebrations unforgettable. Reach out to us any time!</p>

		<div class="mt-8 grid gap-5 sm:grid-cols-2">
			<a
				href="https://wa.me/918690924378"
				target="_blank"
				rel="noreferrer"
				class="flex items-center gap-4 rounded-2xl border border-[#c7edce] bg-[#f0faf2] p-5 transition hover:shadow-md"
			>
				<span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#25d366] text-white">
					<svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
						<path d="M12.04 2C6.58 2 2.15 6.36 2.15 11.72c0 2.12.7 4.16 1.99 5.84L2 22l4.62-1.2a10.05 10.05 0 0 0 5.42 1.58h.01c5.46 0 9.89-4.36 9.89-9.72S17.5 2 12.04 2zm5.8 13.58c-.24.66-1.4 1.25-1.95 1.34-.5.08-1.13.12-1.82-.1-.42-.13-.97-.31-1.67-.6-2.94-1.25-4.85-4.2-4.99-4.4-.13-.19-1.2-1.55-1.2-2.96 0-1.42.74-2.11 1-2.39.26-.28.57-.35.76-.35.19 0 .38 0 .54.01.17.01.4-.06.62.47.24.58.82 2 .89 2.15.07.15.11.33.02.52-.09.19-.13.31-.26.48-.13.17-.27.38-.39.51-.13.13-.26.27-.11.53.14.25.62 1.01 1.33 1.63.92.81 1.7 1.06 1.95 1.18.24.12.38.1.52-.06.14-.16.6-.69.76-.93.16-.24.33-.2.55-.12.22.08 1.41.66 1.66.78.25.12.41.18.47.28.06.1.06.6-.18 1.26z"/>
					</svg>
				</span>
				<div>
					<p class="text-base font-bold text-[#1f2a44]">WhatsApp Us</p>
					<p class="text-sm text-[#22c35e]">+91 86909 24378</p>
					<p class="text-xs text-[#6b7a99]">Available 24x7</p>
				</div>
			</a>

			<a
				href="tel:+918690924378"
				class="flex items-center gap-4 rounded-2xl border border-[#d0daf7] bg-[#f4f6ff] p-5 transition hover:shadow-md"
			>
				<span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#6b3fe7] text-white">
					<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M22 16.9v3a2.1 2.1 0 0 1-2.3 2.1A19.2 19.2 0 0 1 3 5.3 2.1 2.1 0 0 1 5.1 3h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.7 2.8a2 2 0 0 1-.4 2.1l-1.2 1.2a16 16 0 0 0 4.9 4.9l1.2-1.2a2 2 0 0 1 2.1-.4c.9.4 1.8.6 2.8.7A2 2 0 0 1 22 16.9z"></path>
					</svg>
				</span>
				<div>
					<p class="text-base font-bold text-[#1f2a44]">Call Us</p>
					<p class="text-sm text-[#6b3fe7]">+91 86909 24378</p>
					<p class="text-xs text-[#6b7a99]">10AM – 7:30PM</p>
				</div>
			</a>

			<a
				href="mailto:info@balloondecorjaipur.com"
				class="flex items-center gap-4 rounded-2xl border border-[#d0daf7] bg-[#f8f9fe] p-5 transition hover:shadow-md"
			>
				<span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#4f5e7c] text-white">
					<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
						<rect x="3" y="5" width="18" height="14" rx="2"></rect>
						<path d="m3 8 9 6 9-6"></path>
					</svg>
				</span>
				<div>
					<p class="text-base font-bold text-[#1f2a44]">Email Us</p>
					<p class="text-sm text-[#4f5e7c]">info@balloondecorjaipur.com</p>
					<p class="text-xs text-[#6b7a99]">We reply within 24 hours</p>
				</div>
			</a>

			<a
				href="https://www.instagram.com/balloon_decor_jaipur75/"
				target="_blank"
				rel="noreferrer"
				class="flex items-center gap-4 rounded-2xl border border-[#f0d5f8] bg-[#fdf5ff] p-5 transition hover:shadow-md"
			>
				<span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-[#8a4cf6] to-[#f23f6f] text-white">
					<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
						<rect x="4" y="4" width="16" height="16" rx="4"></rect>
						<circle cx="12" cy="12" r="3.2"></circle>
						<circle cx="17" cy="7" r="0.8" fill="currentColor"></circle>
					</svg>
				</span>
				<div>
					<p class="text-base font-bold text-[#1f2a44]">Instagram</p>
					<p class="text-sm text-[#b46ef0]">@balloon_decor_jaipur75</p>
					<p class="text-xs text-[#6b7a99]">See our latest work</p>
				</div>
			</a>
		</div>

		<div class="mt-10 rounded-2xl border border-[#dee8fb] bg-[#f8fbff] p-6">
			<h2 class="text-xl font-bold text-[#1f2a44]">Our Location</h2>
			<p class="mt-2 text-base text-[#4f5e7c]">We operate across all major areas of Jaipur including Vaishali Nagar, Mansarovar, Malviya Nagar, Jagatpura, C-Scheme, and surrounding localities.</p>
			<p class="mt-3 text-base text-[#4f5e7c]"><strong>Office Address:</strong> Plot No. 14, Sahil Sagar Appartment, (Maharani Farm, Gayatri Nagar B, Durgapura, Jaipur - 302018)</p>
			<p class="mt-3 text-base text-[#4f5e7c]"><strong>Operating Hours:</strong> 10:00 AM – 7:30 PM (Monday to Sunday)</p>
		</div>

		<div class="mt-10">
			<a href="/" class="inline-flex items-center gap-2 rounded-full bg-[#6b3fe7] px-5 py-2.5 text-sm font-semibold text-white">
				← Back to Home
			</a>
		</div>
	</main>
</Layout>


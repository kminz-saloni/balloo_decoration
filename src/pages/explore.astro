---
import Layout from '../layouts/Layout.astro';
import { categoryCatalog } from '../data/category-data';
---

<Layout title="Explore Categories | Balloon Decoration Jaipur">
	<main class="min-h-screen bg-[linear-gradient(180deg,#eef3ff_0%,#f5f8ff_38%,#f3f6ff_100%)] pb-28 lg:pb-10">
		<div class="mx-auto w-full max-w-[1320px] px-3 pt-3 sm:px-6 lg:px-8">
			<section class="mx-auto max-w-[1060px] rounded-[30px] border border-[#d9e4f9] bg-white/95 p-4 shadow-[0_20px_40px_-30px_rgba(56,72,124,0.55)] sm:p-6">
				<div class="mx-auto h-1.5 w-16 rounded-full bg-[#dbe2ee]"></div>

				<div class="mt-5 flex items-start justify-between">
					<div>
						<h1 class="text-3xl font-bold text-[#1f2742] sm:text-4xl">All Categories</h1>
						<p class="mt-1 text-[1rem] text-[#8a94a8] sm:text-lg">Pick a decoration theme</p>
					</div>
					<a
						href="/"
						aria-label="Close explore page"
						class="flex h-11 w-11 items-center justify-center rounded-full bg-[#eef3fb] text-[#7f8aa2] transition hover:bg-[#e6edf8]"
					>
						<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
							<line x1="6" y1="6" x2="18" y2="18"></line>
							<line x1="18" y1="6" x2="6" y2="18"></line>
						</svg>
					</a>
				</div>

				<div class="mt-4 flex items-center gap-3 rounded-2xl border border-[#dbe4f5] bg-white px-4 py-3 shadow-[inset_0_1px_0_rgba(255,255,255,0.7)] sm:py-4">
					<svg viewBox="0 0 24 24" class="h-6 w-6 shrink-0 text-[#667290]" fill="currentColor" aria-hidden="true">
						<path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H10a1.5 1.5 0 0 1 1.5 1.5V10A1.5 1.5 0 0 1 10 11.5H5.5A1.5 1.5 0 0 1 4 10V5.5zm8.5 0A1.5 1.5 0 0 1 14 4h4.5A1.5 1.5 0 0 1 20 5.5V10a1.5 1.5 0 0 1-1.5 1.5H14a1.5 1.5 0 0 1-1.5-1.5V5.5zM4 14a1.5 1.5 0 0 1 1.5-1.5H10A1.5 1.5 0 0 1 11.5 14v4.5A1.5 1.5 0 0 1 10 20H5.5A1.5 1.5 0 0 1 4 18.5V14zm8.5 0A1.5 1.5 0 0 1 14 12.5h4.5A1.5 1.5 0 0 1 20 14v4.5A1.5 1.5 0 0 1 18.5 20H14a1.5 1.5 0 0 1-1.5-1.5V14z" />
					</svg>
					<span class="h-7 w-px bg-[#d5ddee]"></span>
					<input
						id="category-search"
						type="search"
						placeholder="Search categories..."
						class="min-w-0 w-full appearance-none bg-transparent text-lg text-[#2d3752] caret-[#5e46cc] opacity-100 placeholder:text-[#8c96ac] focus:outline-none"
					/>
				</div>

				<div class="mt-5 grid grid-cols-3 gap-3 sm:gap-4">
					{
						categoryCatalog.map((category) => (
							<a
								href={`/category/${category.slug}`}
								data-category-card
								data-category-name={category.title.toLowerCase()}
								class="rounded-2xl p-1"
							>
								<img
									src={category.heroImage}
									alt={category.title}
									class="aspect-[0.88] w-full rounded-2xl border border-[#e0e8f9] object-cover shadow-[0_10px_18px_-18px_rgba(58,72,114,0.8)]"
									loading="lazy"
								/>
								<h2 class="mt-2 text-center text-[0.97rem] font-medium text-[#39445e] sm:text-xl">{category.title}</h2>
							</a>
						))
					}
				</div>

				<p id="category-empty" class="hidden py-8 text-center text-base font-medium text-[#7e89a0]">
					No matching categories found.
				</p>
			</section>
		</div>

		<nav
			class="fixed inset-x-0 bottom-0 z-50 border-t border-[#d9e3f2] bg-white/95 px-4 pt-2 pb-[max(0.45rem,env(safe-area-inset-bottom))] shadow-[0_-10px_26px_-20px_rgba(71,94,150,0.8)] backdrop-blur lg:hidden"
		>
			<ul class="mx-auto grid max-w-md grid-cols-4 gap-1">
				<li>
					<a href="/" class="flex flex-col items-center gap-1 text-[#6c758b]">
						<span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#f2f5fb]">
							<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M3 11.5 12 4l9 7.5"></path>
								<path d="M6.5 10.5V20h11V10.5"></path>
							</svg>
						</span>
						<span class="text-sm font-medium">Home</span>
					</a>
				</li>
				<li>
					<a href="/explore" class="flex flex-col items-center gap-1 text-[#5b4fda]">
						<span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#efe8ff]">
							<svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
								<path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H10a1.5 1.5 0 0 1 1.5 1.5V10A1.5 1.5 0 0 1 10 11.5H5.5A1.5 1.5 0 0 1 4 10V5.5zm8.5 0A1.5 1.5 0 0 1 14 4h4.5A1.5 1.5 0 0 1 20 5.5V10a1.5 1.5 0 0 1-1.5 1.5H14a1.5 1.5 0 0 1-1.5-1.5V5.5zM4 14a1.5 1.5 0 0 1 1.5-1.5H10A1.5 1.5 0 0 1 11.5 14v4.5A1.5 1.5 0 0 1 10 20H5.5A1.5 1.5 0 0 1 4 18.5V14zm8.5 0A1.5 1.5 0 0 1 14 12.5h4.5A1.5 1.5 0 0 1 20 14v4.5A1.5 1.5 0 0 1 18.5 20H14a1.5 1.5 0 0 1-1.5-1.5V14z" />
							</svg>
						</span>
						<span class="text-sm font-medium">Explore</span>
					</a>
				</li>
				<li>
					<a href="tel:+919999999999" class="flex flex-col items-center gap-1 text-[#6c758b]">
						<span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#f2f5fb]">
							<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M22 16.9v3a2.1 2.1 0 0 1-2.3 2.1A19.2 19.2 0 0 1 3 5.3 2.1 2.1 0 0 1 5.1 3h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.7 2.8a2 2 0 0 1-.4 2.1l-1.2 1.2a16 16 0 0 0 4.9 4.9l1.2-1.2a2 2 0 0 1 2.1-.4c.9.4 1.8.6 2.8.7A2 2 0 0 1 22 16.9z"></path>
							</svg>
						</span>
						<span class="text-sm font-medium text-[#5f6b86]">Call</span>
					</a>
				</li>
				<li>
					<a href="https://wa.me/919999999999" class="flex flex-col items-center gap-1 text-[#27b45c]">
						<span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#e9f9ef]">
							<svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
								<path d="M12.04 2C6.58 2 2.15 6.36 2.15 11.72c0 2.12.7 4.16 1.99 5.84L2 22l4.62-1.2a10.05 10.05 0 0 0 5.42 1.58h.01c5.46 0 9.89-4.36 9.89-9.72S17.5 2 12.04 2zm5.8 13.58c-.24.66-1.4 1.25-1.95 1.34-.5.08-1.13.12-1.82-.1-.42-.13-.97-.31-1.67-.6-2.94-1.25-4.85-4.2-4.99-4.4-.13-.19-1.2-1.55-1.2-2.96 0-1.42.74-2.11 1-2.39.26-.28.57-.35.76-.35.19 0 .38 0 .54.01.17.01.4-.06.62.47.24.58.82 2 .89 2.15.07.15.11.33.02.52-.09.19-.13.31-.26.48-.13.17-.27.38-.39.51-.13.13-.26.27-.11.53.14.25.62 1.01 1.33 1.63.92.81 1.7 1.06 1.95 1.18.24.12.38.1.52-.06.14-.16.6-.69.76-.93.16-.24.33-.2.55-.12.22.08 1.41.66 1.66.78.25.12.41.18.47.28.06.1.06.6-.18 1.26z" />
							</svg>
						</span>
						<span class="text-sm font-medium text-[#5f6b86]">WhatsApp</span>
					</a>
				</li>
			</ul>
		</nav>
	</main>

	<script>
		const searchInput = document.getElementById('category-search');
		const cards = Array.from(document.querySelectorAll('[data-category-card]'));
		const emptyMessage = document.getElementById('category-empty');

		searchInput?.addEventListener('input', () => {
			const query = searchInput.value.trim().toLowerCase();
			let visibleCount = 0;

			cards.forEach((card) => {
				const name = card.getAttribute('data-category-name') || '';
				const match = name.includes(query);
				card.classList.toggle('hidden', !match);
				if (match) visibleCount += 1;
			});

			emptyMessage?.classList.toggle('hidden', visibleCount !== 0);
		});

		const queryFromUrl = new URLSearchParams(window.location.search).get('q');
		if (queryFromUrl && searchInput instanceof HTMLInputElement) {
			searchInput.value = queryFromUrl;
			searchInput.dispatchEvent(new Event('input'));
		}
	</script>
</Layout>

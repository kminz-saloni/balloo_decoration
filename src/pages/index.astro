---

<Layout title="Jaipur Balloon Decoration | Book Now" description="Jaipur's most-booked balloon decoration service. Birthday, anniversary, baby shower & more. Same-day slots available. Book now on WhatsApp!">
	<main class="relative min-h-screen overflow-x-clip pb-28 lg:pb-10">
		<div class="border-b border-[#dee8fb] bg-white/90 backdrop-blur">
			<div class="mx-auto w-full max-w-[1320px] px-4 sm:px-6 lg:px-8">
				<header class="page-reveal py-4 lg:py-5">
					<div class="flex items-center gap-2 sm:gap-4">


						<img
							src="https://camsstorage2026abcd.blob.core.windows.net/balooon/Gfg-logo.webp"
							alt="Jaipur Balloon Decoration"
							class="h-12 w-auto rounded-lg object-contain lg:h-16"
						/>

						<div
							class="hidden items-center gap-2 rounded-full bg-gradient-to-r from-[#7c3aed] to-[#d946ef] px-4 py-2.5 text-sm font-bold text-white shadow-[0_4px_14px_rgba(124,58,237,0.35)] transition-all duration-300 hover:scale-105 hover:shadow-[0_6px_20px_rgba(124,58,237,0.5)] lg:flex cursor-default"
						>
							<svg viewBox="0 0 24 24" class="h-4 w-4 animate-[bounce_2s_infinite]" fill="none" stroke="currentColor" stroke-width="2.5">
								<path d="M12 21s7-4.35 7-11a7 7 0 1 0-14 0c0 6.65 7 11 7 11z"></path>
								<circle cx="12" cy="10" r="2.3"></circle>
							</svg>
							<span class="tracking-wide">Jaipur</span>
						</div>

						<div class="hidden flex-1 lg:block">
							<div
								class="flex items-center overflow-hidden rounded-2xl border border-[#d9e3f2] bg-[#f5f8ff] shadow-inner shadow-white/60"
							>
								<div class="px-4 text-[#7f8aa3]">
									<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
										<circle cx="11" cy="11" r="7"></circle>
										<line x1="16.65" y1="16.65" x2="21" y2="21"></line>
									</svg>
								</div>
								<input
									id="home-search-input-desktop"
									type="text"
									placeholder='Search "Birthday decoration"...'
									class="h-14 w-full border-none bg-transparent pr-2 text-[17px] text-[#2f3550] placeholder:text-[#7f8aa3] focus:outline-none"
								/>
								<button
									type="button"
									id="home-search-button-desktop"
									data-home-search-trigger
									aria-label="Search"
									class="flex h-14 min-w-[140px] items-center justify-center gap-2 bg-gradient-to-b from-[#5b4fda] to-[#7a4def] px-4 text-lg font-semibold text-white"
								>
									<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
										<circle cx="11" cy="11" r="7"></circle>
										<line x1="16.65" y1="16.65" x2="21" y2="21"></line>
									</svg>
									<span>Search</span>
								</button>
							</div>
						</div>

						<div
							class="inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-[#7c3aed] to-[#d946ef] px-3 py-2 text-xs font-bold leading-none text-white shadow-[0_4px_10px_rgba(124,58,237,0.25)] lg:hidden"
						>
							<svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5">
								<path d="M12 21s7-4.35 7-11a7 7 0 1 0-14 0c0 6.65 7 11 7 11z"></path>
								<circle cx="12" cy="10" r="2.3"></circle>
							</svg>
							<span class="tracking-wide">Jaipur</span>
						</div>

						<a
							href="https://wa.me/918690924378?text=Hi%2C%20I%20want%20to%20book%20balloon%20decoration%20in%20Jaipur"
							target="_blank"
							rel="noreferrer"
							class="ml-auto inline-flex items-center justify-center rounded-full bg-gradient-to-r from-[#4f46e5] to-[#7c3aed] px-3 py-2.5 text-sm font-semibold text-white shadow-[0_12px_24px_-14px_rgba(90,49,180,0.75)] transition hover:translate-y-[-1px] hover:shadow-[0_14px_24px_-14px_rgba(90,49,180,0.95)] sm:px-6"
						>
							Book Now
						</a>
					</div>

					<div

---

<Layout title="Jaipur Balloon Decoration | Book Now">
	<main class="relative min-h-screen overflow-x-clip pb-28 lg:pb-10">
		<div class="border-b border-[#dee8fb] bg-white/90 backdrop-blur">
			<div class="mx-auto w-full max-w-[1320px] px-4 sm:px-6 lg:px-8">
				<header class="page-reveal py-4 lg:py-5">
					<div class="flex items-center gap-2 sm:gap-4">
						<button
							type="button"
							aria-label="Open navigation menu"
							id="mobile-menu-button"
							class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-[#dce8ff] bg-[#eff5ff] text-[#5e46cc] transition hover:bg-[#e7f0ff] lg:hidden"
						>
							<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
								<line x1="4" y1="7" x2="20" y2="7"></line>
								<line x1="4" y1="12" x2="20" y2="12"></line>
								<line x1="4" y1="17" x2="20" y2="17"></line>
							</svg>
						</button>

						<img
							src="/Gfg-logo.png"
							alt="Jaipur Balloon Decoration"
							class="h-10 w-auto rounded-lg object-contain lg:h-12"
						/>

						<div
							class="hidden items-center gap-2 rounded-full bg-gradient-to-r from-[#7c3aed] to-[#d946ef] px-4 py-2.5 text-sm font-bold text-white shadow-[0_4px_14px_rgba(124,58,237,0.35)] transition-all duration-300 hover:scale-105 hover:shadow-[0_6px_20px_rgba(124,58,237,0.5)] lg:flex cursor-default"
						>
							<svg viewBox="0 0 24 24" class="h-4 w-4 animate-[bounce_2s_infinite]" fill="none" stroke="currentColor" stroke-width="2.5">
								<path d="M12 21s7-4.35 7-11a7 7 0 1 0-14 0c0 6.65 7 11 7 11z"></path>
								<circle cx="12" cy="10" r="2.3"></circle>
							</svg>
							<span class="tracking-wide">Jaipur</span>
						</div>

						<div class="hidden flex-1 lg:block">
							<div
								class="flex items-center overflow-hidden rounded-2xl border border-[#d9e3f2] bg-[#f5f8ff] shadow-inner shadow-white/60"
							>
								<div class="px-4 text-[#7f8aa3]">
									<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
										<circle cx="11" cy="11" r="7"></circle>
										<line x1="16.65" y1="16.65" x2="21" y2="21"></line>
									</svg>
								</div>
								<input
									id="home-search-input-desktop"
									type="text"
									placeholder='Search "Birthday decoration"...'
									class="h-14 w-full border-none bg-transparent pr-2 text-[17px] text-[#2f3550] placeholder:text-[#7f8aa3] focus:outline-none"
								/>
								<button
									type="button"
									id="home-search-button-desktop"
									data-home-search-trigger
									aria-label="Search"
									class="flex h-14 min-w-[140px] items-center justify-center gap-2 bg-gradient-to-b from-[#5b4fda] to-[#7a4def] px-4 text-lg font-semibold text-white"
								>
									<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
										<circle cx="11" cy="11" r="7"></circle>
										<line x1="16.65" y1="16.65" x2="21" y2="21"></line>
									</svg>
									<span>Search</span>
								</button>
							</div>
						</div>

						<div
							class="inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-[#7c3aed] to-[#d946ef] px-3 py-2 text-xs font-bold leading-none text-white shadow-[0_4px_10px_rgba(124,58,237,0.25)] lg:hidden"
						>
							<svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5">
								<path d="M12 21s7-4.35 7-11a7 7 0 1 0-14 0c0 6.65 7 11 7 11z"></path>
								<circle cx="12" cy="10" r="2.3"></circle>
							</svg>
							<span class="tracking-wide">Jaipur</span>
						</div>

						<button
							type="button"
							class="ml-auto rounded-full bg-gradient-to-r from-[#4f46e5] to-[#7c3aed] px-3 py-2.5 text-sm font-semibold text-white shadow-[0_12px_24px_-14px_rgba(90,49,180,0.75)] transition hover:translate-y-[-1px] hover:shadow-[0_14px_24px_-14px_rgba(90,49,180,0.95)] sm:px-6"
						>
							Book Now
						</button>
					</div>

					<div
						class="mt-3 flex items-center overflow-hidden rounded-2xl border border-[#d9e3f2] bg-[#f5f8ff] shadow-inner shadow-white/60 lg:hidden"
					>
						<div class="px-4 text-[#7f8aa3]">
							<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="11" cy="11" r="7"></circle>
								<line x1="16.65" y1="16.65" x2="21" y2="21"></line>
							</svg>
						</div>
						<input
							id="home-search-input-mobile"
							type="text"
							placeholder='Search "Birthday decoration"...'
							class="h-14 w-full border-none bg-transparent pr-2 text-[17px] text-[#2f3550] placeholder:text-[#7f8aa3] focus:outline-none"
						/>
						<button
							type="button"
							id="home-search-button-mobile"
							data-home-search-trigger
							aria-label="Search"
							class="flex h-14 w-14 items-center justify-center bg-gradient-to-b from-[#5b4fda] to-[#7a4def] text-white"
						>
							<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="11" cy="11" r="7"></circle>
								<line x1="16.65" y1="16.65" x2="21" y2="21"></line>
							</svg>
						</button>
					</div>

				</header>
			</div>
		</div>

		<div class="hidden border-b border-[#d9e3f2] bg-white/92 backdrop-blur lg:block">
			<div class="mx-auto w-full max-w-[1320px] px-4 sm:px-6 lg:px-8">
				<nav
					class="page-reveal category-scroll flex flex-nowrap items-center gap-2 overflow-x-auto py-3 whitespace-nowrap lg:gap-3"
					style="animation-delay: 50ms;"
				>
						{
							topNavCategories.map((category) => (
								<a
									href={categoryHref(category)}
									class="shrink-0 rounded-full border border-[#d9e3f2] bg-[#f5f8ff] px-4 py-2 text-sm font-semibold text-[#1f2a44] transition hover:border-[#c8d5ee] hover:bg-[#edf3ff] lg:text-base"
								>
									{category}
								</a>
						))
					}
				</nav>
			</div>
		</div>

		<div class="mx-auto w-full max-w-[1320px] px-4 pt-3 sm:px-6 lg:px-8 lg:pt-4">
			<section
				class="page-reveal rounded-[28px] border border-white/70 bg-white/90 p-2 shadow-[0_16px_38px_-26px_rgba(67,61,128,0.35)] backdrop-blur sm:p-3"
				style="animation-delay: 80ms;"
			>
				<img
					src="/Hero%20Image.jpeg"
					alt="India's No.1 decoration service banner"
					class="h-auto w-full rounded-[22px] object-cover"
				/>
			</section>

			<section class="mt-9 pb-2">
				<div class="page-reveal relative text-center" style="animation-delay: 140ms;">
					<h2 class="text-3xl font-extrabold leading-tight tracking-tight text-[#1f2a44] sm:text-4xl">
						India&apos;s No.1 Decor
					</h2>
					<p class="mt-2 text-lg font-medium text-[#5f6b86] sm:text-xl">
						Trusted Decorators for all events
					</p>
					<a
						href="/explore"
						class="absolute top-0 right-0 hidden rounded-full border border-[#d9e3f2] bg-white px-3 py-1.5 text-xs font-semibold text-[#5a4fd8] shadow-sm transition hover:border-[#c8d5ee] hover:bg-[#f7f9ff] lg:inline-flex"
					>
						View all
					</a>
				</div>

					<div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-3 lg:grid-cols-5 lg:gap-4 xl:grid-cols-6">
						{
							categories.slice(0, 6).map((category, index) => (
								<a
									href={categoryHref(category.title)}
									class="stagger-item overflow-hidden rounded-2xl border border-[#d9e3f2] bg-white p-2.5 shadow-[0_12px_24px_-20px_rgba(54,67,122,0.36)]"
									style={`animation-delay: ${180 + index * 55}ms;`}
								>
									<img
										src={category.image}
									alt={category.title}
									class="aspect-square w-full rounded-xl object-cover"
									loading="lazy"
								/>
									<h3 class="mt-2 text-center text-[0.92rem] font-semibold leading-tight text-[#1f2a44] sm:text-[0.98rem]">
										{category.title}
									</h3>
								</a>
							))
						}
					</div>
			</section>

			<section class="mt-12 pb-4">
				<div class="page-reveal text-center" style="animation-delay: 160ms;">
					<div class="mx-auto mb-3 h-[3px] w-full max-w-[520px] rounded-full bg-gradient-to-r from-[#f6a4bc] via-[#e2cef9] to-[#f6a4bc]"></div>
					<h2 class="text-3xl font-extrabold leading-tight tracking-tight text-[#1f2a44] sm:text-4xl">Kids Special</h2>
					<p class="mt-2 text-lg font-medium text-[#5f6b86] sm:text-xl">Fun-Filled Themes for Every Celebration!</p>
				</div>

					<div class="mt-6 grid grid-cols-3 gap-3 sm:gap-4 lg:grid-cols-6 lg:gap-4">
						{
							kidsSpecialThemes.map((theme, index) => (
								<a
									href={`/sub-category/${theme.slug}`}

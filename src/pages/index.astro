			if (!homeSearchIndexNode?.textContent) return [];
			try {
				const parsed = JSON.parse(homeSearchIndexNode.textContent);
				return Array.isArray(parsed) ? parsed : [];
			} catch {
				return [];
			}
		};
		const homeSearchIndex = parseHomeSearchIndex();

		const normalizeSearchText = (value) => value.toLowerCase().replace(/[^a-z0-9\s]/g, ' ').replace(/\s+/g, ' ').trim();

		const findHomeSearchMatch = (query) => {
			const normalizedQuery = normalizeSearchText(query);
			if (!normalizedQuery) return null;

			const exactMatch = homeSearchIndex.find((entry) => normalizeSearchText(entry.term) === normalizedQuery);
			if (exactMatch) return exactMatch;

			const startsWithMatch = homeSearchIndex.find((entry) =>
				normalizeSearchText(entry.term).startsWith(normalizedQuery)
			);
			if (startsWithMatch) return startsWithMatch;

			return homeSearchIndex.find((entry) => normalizeSearchText(entry.term).includes(normalizedQuery)) || null;
		};

		const runHomeSearch = (sourceInput) => {
			if (!(sourceInput instanceof HTMLInputElement)) return;
			const query = sourceInput.value.trim();
			if (!query) return;

			const match = findHomeSearchMatch(query);
			if (match?.slug) {
				window.location.href = `/category/${match.slug}?q=${encodeURIComponent(query)}`;
				return;
			}

			window.location.href = `/explore?q=${encodeURIComponent(query)}`;
		};

		const bindHomeSearchInput = (input) => {
			if (!(input instanceof HTMLInputElement)) return;
			input.addEventListener('keydown', (event) => {
				if (event.key !== 'Enter') return;
				event.preventDefault();
				runHomeSearch(input);
			});
		};

		bindHomeSearchInput(desktopSearchInput);
		bindHomeSearchInput(mobileSearchInput);

		desktopSearchButton?.addEventListener('click', () => runHomeSearch(desktopSearchInput));
		mobileSearchButton?.addEventListener('click', () => runHomeSearch(mobileSearchInput));

		const openMenu = () => {
			if (!menuOverlay || !menuPanel) return;
			menuOverlay.classList.remove('opacity-0', 'pointer-events-none');
			menuPanel.classList.remove('-translate-x-full');
			document.body.classList.add('overflow-hidden');
		};

		const closeMenu = () => {
			if (!menuOverlay || !menuPanel) return;
			menuOverlay.classList.add('opacity-0', 'pointer-events-none');
			menuPanel.classList.add('-translate-x-full');
			document.body.classList.remove('overflow-hidden');
		};

		menuButton?.addEventListener('click', () => {
			if (!menuOverlay) return;
			const isClosed = menuOverlay.classList.contains('opacity-0');
			if (isClosed) openMenu();
			else closeMenu();
		});

		// Fallback delegated handler to keep burger reliable across dynamic page swaps.
		document.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const trigger = target.closest('#mobile-menu-button');
			if (!trigger) return;

			const overlay = document.getElementById('mobile-menu-overlay');
			const panel = document.getElementById('mobile-menu-panel');
			if (!overlay || !panel) return;

			const isClosed = overlay.classList.contains('opacity-0');
			if (isClosed) {
				overlay.classList.remove('opacity-0', 'pointer-events-none');
				panel.classList.remove('-translate-x-full');
				document.body.classList.add('overflow-hidden');
			} else {
				overlay.classList.add('opacity-0', 'pointer-events-none');
				panel.classList.add('-translate-x-full');
				document.body.classList.remove('overflow-hidden');
			}
		});

		menuOverlay?.addEventListener('click', (event) => {
			if (event.target === menuOverlay) closeMenu();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeMenu();
		});

		closeLinks.forEach((element) => {
			element.addEventListener('click', () => closeMenu());
		});

		const setupCarousel = (prefix) => {
			const track = document.getElementById(`${prefix}-carousel-track`);
			const prev = document.getElementById(`${prefix}-carousel-prev`);
			const next = document.getElementById(`${prefix}-carousel-next`);
			if (!track) return;

			const scrollByOne = (direction) => {
				const firstSlide = track.querySelector('[data-carousel-slide]');
				if (!(firstSlide instanceof HTMLElement)) return;
				const styles = window.getComputedStyle(track);
				const gap = Number.parseFloat(styles.columnGap || styles.gap || '12') || 12;
				const offset = firstSlide.getBoundingClientRect().width + gap;
				track.scrollBy({ left: offset * direction, behavior: 'smooth' });
			};

			prev?.addEventListener('click', () => scrollByOne(-1));
			next?.addEventListener('click', () => scrollByOne(1));
		};

		['kids', 'wedding', 'romantic', 'review'].forEach((name) => setupCarousel(name));

		const faqEntries = document.querySelectorAll('[data-faq-item]');

		const setFaqState = (entry, isOpen) => {
			entry.dataset.open = isOpen ? 'true' : 'false';
			entry.classList.toggle('border-[#cbb7fb]', isOpen);
			entry.classList.toggle('bg-[#f3edff]', isOpen);
			entry.classList.toggle('border-[#e6ebf7]', !isOpen);
			entry.classList.toggle('bg-white', !isOpen);

			const content = entry.querySelector('[data-faq-content]');
			const iconWrap = entry.querySelector('[data-faq-icon-wrap]');
			const plusIcon = entry.querySelector('[data-faq-plus]');
			const minusIcon = entry.querySelector('[data-faq-minus]');

			content?.classList.toggle('hidden', !isOpen);
			plusIcon?.classList.toggle('hidden', isOpen);
			minusIcon?.classList.toggle('hidden', !isOpen);

			iconWrap?.classList.toggle('bg-[#6b3fe7]', isOpen);
			iconWrap?.classList.toggle('text-white', isOpen);
			iconWrap?.classList.toggle('bg-[#eff2f7]', !isOpen);
			iconWrap?.classList.toggle('text-[#75819b]', !isOpen);
		};

		faqEntries.forEach((entry) => {
			setFaqState(entry, entry.dataset.open === 'true');

			const toggle = entry.querySelector('[data-faq-toggle]');
			toggle?.addEventListener('click', () => {
				const wasOpen = entry.dataset.open === 'true';
				faqEntries.forEach((otherEntry) => setFaqState(otherEntry, false));
				if (!wasOpen) setFaqState(entry, true);
			});
		});
	</script>
</Layout>


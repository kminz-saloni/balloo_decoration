---
import Layout from '../../layouts/Layout.astro';

const areas = [
	{
		name: 'Vaishali Nagar',
		slug: 'balloon-decoration-vaishali-nagar-jaipur',
		description: 'We provide premium balloon decoration services across Vaishali Nagar, Jaipur. From birthday setups to anniversary surprises, our team arrives at your doorstep fully equipped.'
	},
	{
		name: 'Mansarovar',
		slug: 'balloon-decoration-mansarovar-jaipur',
		description: 'Book balloon decoration in Mansarovar, Jaipur for all occasions. Our experienced decorators set up beautiful, photo-ready themes for birthdays, weddings, and more.'
	},
	{
		name: 'Malviya Nagar',
		slug: 'balloon-decoration-malviya-nagar-jaipur',
		description: 'Get gorgeous balloon decoration in Malviya Nagar, Jaipur. Same-day slots available for select setups.'
	},
	{
		name: 'Jaipur',
		slug: 'balloon-decoration-jaipur',
		description: 'Jaipur\'s most-booked balloon decoration team. We serve all major areas of Jaipur with beautiful setups for every celebration.'
	}
];

export function getStaticPaths() {
	return [
		{ params: { slug: 'balloon-decoration-vaishali-nagar-jaipur' } },
		{ params: { slug: 'balloon-decoration-mansarovar-jaipur' } },
		{ params: { slug: 'balloon-decoration-malviya-nagar-jaipur' } },
		{ params: { slug: 'balloon-decoration-jaipur' } },
	];
}

const { slug } = Astro.params;
const area = areas.find(a => a.slug === slug);

if (!area) {
	return Astro.redirect('/');
}

const services = [
	'Birthday Balloon Decoration',
	'Anniversary Room Decoration',
	'Baby Shower Decoration',
	'Kids Theme Decoration',
	'Romantic Room Setup',
	'Corporate Event Decoration',
	'Festival Decoration',
];

const categories = [
	{ name: 'Birthday Decoration', href: '/category/birthday-decoration', image: 'https://camsstorage2026abcd.blob.core.windows.net/balooon/Categories/Birthday.webp' },
	{ name: 'Anniversary Decoration', href: '/category/anniversary-decoration', image: 'https://camsstorage2026abcd.blob.core.windows.net/balooon/Categories/Anniversary%20Decor.webp' },
	{ name: 'Baby Shower', href: '/category/baby-shower-decoration', image: 'https://camsstorage2026abcd.blob.core.windows.net/balooon/Categories/Baby%20Shower.webp' },
	{ name: 'Kids Special', href: '/category/kids-theme-decoration', image: 'https://camsstorage2026abcd.blob.core.windows.net/balooon/Categories/Kids%20Special.webp' },
	{ name: 'Romantic Decor', href: '/category/romantic-room-decoration', image: 'https://camsstorage2026abcd.blob.core.windows.net/balooon/Categories/Room%20Decor%20New.webp' },
];
---

<Layout
	title={`Balloon Decoration in ${area.name}, Jaipur | Book Now`}
	description={`${area.description} Same-day booking available. Call or WhatsApp us at +91 86909 24378.`}
>
	<main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
		<!-- Hero -->
		<section class="rounded-[24px] bg-gradient-to-br from-[#6b3fe7] via-[#7a4def] to-[#5b2ec7] p-7 text-white">
			<p class="text-xs font-bold tracking-[0.15em] text-white/80">&#9733; BALLOON DECORATION IN JAIPUR</p>
			<h1 class="mt-3 text-3xl font-extrabold leading-tight sm:text-4xl">
				Balloon Decoration in {area.name}, Jaipur
			</h1>
			<p class="mt-3 text-base text-white/85 sm:text-lg">{area.description}</p>
			<p class="mt-2 text-sm font-semibold text-white/90">Same-day slots available</p>

			<div class="mt-6 flex flex-wrap gap-3">
				<a
					href={`https://wa.me/918690924378?text=${encodeURIComponent(`Hi, I want to book balloon decoration in ${area.name}, Jaipur`)}`}
					target="_blank"
					rel="noreferrer"
					class="inline-flex items-center gap-2 rounded-full bg-[#25d366] px-6 py-3 text-sm font-bold text-white shadow-lg"
				>
					Book on WhatsApp
				</a>
				<a
					href="tel:+918690924378"
					class="inline-flex items-center gap-2 rounded-full border border-white/40 bg-white/15 px-6 py-3 text-sm font-semibold text-white"
				>
					Call Us
				</a>
			</div>
		</section>

		<!-- Services -->
		<section class="mt-12">
			<h2 class="text-2xl font-extrabold text-[#1f2a44]">Our Services in {area.name}</h2>
			<p class="mt-1 text-base text-[#6b7a99]">Complete decoration solutions for every occasion</p>
			<ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
				{services.map(service => (
					<li class="flex items-center gap-2 rounded-xl border border-[#dee8fb] bg-[#f8fbff] px-4 py-3 text-sm font-medium text-[#3a4565]">
						<span class="text-[#6b3fe7]">✓</span>
						{service}
					</li>
				))}
			</ul>
		</section>

		<!-- Categories -->
		<section class="mt-12">
			<h2 class="text-2xl font-extrabold text-[#1f2a44]">Popular Decoration Categories</h2>
			<div class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3">
				{categories.map(cat => (
					<a href={cat.href} class="overflow-hidden rounded-2xl border border-[#d9e3f2] bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-md">
						<img src={cat.image} alt={cat.name} class="h-32 w-full object-cover" loading="lazy" />
						<div class="p-3">
							<p class="text-sm font-semibold text-[#1f2a44]">{cat.name}</p>
						</div>
					</a>
				))}
			</div>
		</section>

		<!-- Why Us -->
		<section class="mt-12 rounded-2xl border border-[#dee8fb] bg-[#f8fbff] p-6">
			<h2 class="text-xl font-extrabold text-[#1f2a44]">Why Choose Us in {area.name}?</h2>
			<ul class="mt-4 space-y-3 text-base text-[#4f5e7c]">
				<li class="flex items-start gap-2"><span class="text-[#6b3fe7] font-bold">✓</span> We bring all materials — balloons, props, setup crew</li>
				<li class="flex items-start gap-2"><span class="text-[#6b3fe7] font-bold">✓</span> Same-day booking available for select setups</li>
				<li class="flex items-start gap-2"><span class="text-[#6b3fe7] font-bold">✓</span> Custom themes designed for your event</li>
				<li class="flex items-start gap-2"><span class="text-[#6b3fe7] font-bold">✓</span> 500+ satisfied customers across Jaipur</li>
			</ul>
		</section>

		<!-- CTA -->
		<section class="mt-10 text-center">
			<h2 class="text-2xl font-extrabold text-[#1f2a44]">Book Your Decoration in {area.name} Today</h2>
			<p class="mt-2 text-base text-[#6b7a99]">Call or WhatsApp us to check availability and confirm your booking</p>
			<div class="mt-5 flex flex-wrap justify-center gap-3">
				<a
					href={`https://wa.me/918690924378?text=${encodeURIComponent(`Hi, I want to book balloon decoration in ${area.name}, Jaipur`)}`}
					target="_blank"
					rel="noreferrer"
					class="inline-flex items-center gap-2 rounded-full bg-[#25d366] px-8 py-3 text-sm font-bold text-white shadow-lg"
				>
					Book on WhatsApp
				</a>
				<a
					href="/"
					class="inline-flex items-center gap-2 rounded-full border border-[#d0daf7] bg-white px-8 py-3 text-sm font-semibold text-[#4f5e7c]"
				>
					← Back to Home
				</a>
			</div>
		</section>
	</main>
</Layout>
